<div class="flex flex-col lg:flex-row gap-6">
  <!-- Main Editor Panel -->
  <div class="flex-1">
    <div
      class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden"
    >
      <!-- Enhanced Toolbar -->
      <div id="toolbar" class="border-b border-gray-200 bg-gray-50 p-3">
        <span class="ql-formats">
          <select
            class="ql-header border border-gray-300 rounded px-2 py-1 mr-2"
          >
            <option value="1">H1</option>
            <option value="2">H2</option>
            <option value="3">H3</option>
            <option selected>Normal</option>
          </select>
          <select class="ql-size border border-gray-300 rounded px-2 py-1 mr-2">
            <option value="small">Small</option>
            <option selected>Normal</option>
            <option value="large">Large</option>
          </select>
        </span>

        <span class="ql-formats">
          <button
            class="ql-bold bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-1"
            title="Bold"
          ></button>
          <button
            class="ql-italic bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-1"
            title="Italic"
          ></button>
          <button
            class="ql-underline bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-1"
            title="Underline"
          ></button>
          <button
            class="ql-strike bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-2"
            title="Strikethrough"
          ></button>
        </span>

        <span class="ql-formats">
          <button
            class="ql-list bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-1"
            value="ordered"
            title="Numbered List"
          ></button>
          <button
            class="ql-list bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-2"
            value="bullet"
            title="Bullet List"
          ></button>
        </span>

        <span class="ql-formats">
          <select
            class="ql-align border border-gray-300 rounded px-2 py-1 mr-2"
            title="Text Alignment"
          >
            <option value=""></option>
            <option value="center"></option>
            <option value="right"></option>
            <option value="justify"></option>
          </select>
          <button
            class="ql-link bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100 mr-1"
            title="Link"
          ></button>
          <button
            class="ql-image bg-white border border-gray-300 rounded w-8 h-8 hover:bg-gray-100"
            title="Image"
          ></button>
        </span>
      </div>

      <!-- Editor Content Area -->
      <div id="editor" class="min-h-[500px] text-gray-800"><%- html %></div>
    </div>

    <!-- Action Buttons -->
    <div
      class="mt-6 flex flex-col sm:flex-row gap-3 items-start sm:items-center"
    >
      <button
        id="saveBtn"
        class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
        Save Document
      </button>

      <button
        id="versionsBtn"
        class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z"
            clip-rule="evenodd"
          />
        </svg>
        Show Versions
      </button>

      <a
        href="/download-zip/<%= docId %>"
        class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 ml-0 sm:ml-auto"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
        Download All
      </a>
      <a
        id="downloadZip"
        href="#"
        class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-2.5 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 ml-auto"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
        Download All as DOCX
      </a>
    </div>
  </div>

  <!-- Versions Sidebar -->
  <div
    id="sidebar"
    class="w-full lg:w-80 bg-white rounded-lg shadow-sm border border-gray-200 p-6 transform translate-x-full lg:translate-x-0 transition-transform duration-300 lg:relative lg:transform-none absolute right-0 top-0 h-full lg:h-auto z-10"
  >
    <div class="flex justify-between items-center mb-6">
      <h3 class="font-bold text-lg text-gray-800">Document Versions</h3>
      <button
        id="closeSidebar"
        class="lg:hidden text-gray-500 hover:text-gray-700"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
    </div>

    <div id="versionsList" class="space-y-3 overflow-auto max-h-[60vh]">
      <div class="text-center text-gray-500 py-8">
        No versions yet. Start editing and save your document!
      </div>
    </div>
  </div>
</div>

<script>
  window.APP = {
    docId: "<%= docId %>",
    initialContent: `<%- html %>`,
  };
</script>
<script src="/public/js/editor.js"></script>
