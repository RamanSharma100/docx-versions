<div class="bg-white rounded-lg shadow p-6 max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-4 text-gray-800">Upload a .docx file</h1>
  <form
    action="/upload"
    method="post"
    enctype="multipart/form-data"
    class="space-y-4"
  >
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2"
        >Select Document</label
      >
      <input
        type="file"
        name="docx"
        accept=".docx"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
      />
    </div>
    <div class="mt-6">
      <button
        class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg font-medium transition-colors duration-200"
      >
        Upload Document
      </button>
    </div>
  </form>
</div>
